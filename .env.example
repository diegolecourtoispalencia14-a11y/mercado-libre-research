# ==========================================
# MERCADO LIBRE RESEARCH & ARBITRAGE SUITE
# Environment Configuration Template
# ==========================================

# 1. Base de Datos & Caché
POSTGRES_DB=research
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql://postgres:your_secure_postgres_password_here@postgres:5432/research
REDIS_URL=redis://redis:6379

# 2. Seguridad & Control Perimetral (OWASP Top 10)
AUTH_ENABLED=true
SECRET_KEY=change_this_to_a_64_character_hex_key_in_production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_master_password_in_production
ADMIN_EMAIL=admin@flamante.lab
TOKEN_EXPIRE_HOURS=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_SECONDS=60
RATE_LIMIT_PER_MINUTE=60

# 3. Mercado Libre Official API Credentials (developers.mercadolibre.com.mx)
ML_SITE_ID=MLM
ML_CLIENT_ID=your_mercadolibre_app_id
ML_CLIENT_SECRET=your_mercadolibre_client_secret
ML_ACCESS_TOKEN=your_ml_access_token_here
ML_REFRESH_TOKEN=your_ml_refresh_token_here

# 4. Puerto de Producción
PORT=80
